@@ -0,0 +1,74 @@
+import { describe, expect, it } from 'vitest';
+import { calculateEffectivePpg, type PpgSample } from '../effectivePpg';
+
+describe('calculateEffectivePpg', () => {
+  it('enforces a minimum floor of 3.0 across all paths', () => {
+    // Zero appearances, low market value -> proxy would be 3.0
+    expect(calculateEffectivePpg([], [], 0)).toBe(3.0);
+
+    // Negative or very low points
+    const poorStats: PpgSample[] = [
+      { points: 0.5, minutes: 90 },
+      { points: 1.0, minutes: 90 },
+    ];
+    expect(calculateEffectivePpg(poorStats, [], 5)).toBe(3.0);
+  });
+
+  it('uses market-value proxy when player has 0 appearances and no history', () => {
+    expect(calculateEffectivePpg([], [], 85)).toBe(10.0);
+    expect(calculateEffectivePpg([], [], 50)).toBe(8.0);
+    expect(calculateEffectivePpg([], [], 25)).toBe(6.0);
+    expect(calculateEffectivePpg([], [], 15)).toBe(4.5);
+    expect(calculateEffectivePpg([], [], 5)).toBe(3.0);
+  });
+
+  it('uses prior-season history with reliability adjustment when player has 0 current appearances', () => {
+    // 1500+ minutes -> reliability = 1.0, pure prior PPG
+    const fullPrior: PpgSample[] = Array.from({ length: 20 }, () => ({ points: 8.0, minutes: 90 }));
+    expect(calculateEffectivePpg([], fullPrior, 10)).toBe(8.0);
+
+    // Thin minutes -> pulled toward 4.0
+    // 300 minutes -> reliability = 300/1500 = 0.2
+    // ppg = 10.0 -> 0.2 * 10.0 + 0.8 * 4.0 = 2.0 + 3.2 = 5.2
+    const thinPrior: PpgSample[] = [
+      { points: 10.0, minutes: 150 },
+      { points: 10.0, minutes: 150 },
+    ];
+    expect(calculateEffectivePpg([], thinPrior, 10)).toBe(5.2);
+  });
+
+  it('weights 60% last-10 and 40% season average when appearances >= 10', () => {
+    // 15 appearances: last 10 at 10.0, first 5 at 5.0
+    // Season avg: (10*10 + 5*5) / 15 = 125 / 15 = 8.3333...
+    // Recent avg: 10.0
+    // Blend: 0.6 * 10.0 + 0.4 * 8.3333... = 6.0 + 3.3333... = 9.3333...
+    const currStats: PpgSample[] = [
+      ...Array.from({ length: 10 }, () => ({ points: 10.0, minutes: 90 })),
+      ...Array.from({ length: 5 }, () => ({ points: 5.0, minutes: 90 })),
+    ];
+    const result = calculateEffectivePpg(currStats, [], 50);
+    expect(result).toBeCloseTo(9.333, 2);
+  });
+
+  it('blends current season against prior season when appearances are between 1 and 9', () => {
+    // N = 5 appearances -> weightThis = 5/10 = 0.5
+    // thisSeason: 8.0 avg
+    // priorSeason: 20 appearances of 6.0 (reliability = 1.0)
+    // Blend: 0.5 * 8.0 + 0.5 * 6.0 = 7.0
+    const currStats: PpgSample[] = Array.from({ length: 5 }, () => ({ points: 8.0, minutes: 90 }));
+    const prevStats: PpgSample[] = Array.from({ length: 20 }, () => ({ points: 6.0, minutes: 90 }));
+    expect(calculateEffectivePpg(currStats, prevStats, 30)).toBe(7.0);
+  });
+
+  it('blends current season against market value proxy when no prior season exists and N < 10', () => {
+    // N = 2 appearances -> weightActual = min(1.0, 2/5) = 0.4
+    // thisSeason: 10.0 avg
+    // MV = 50 -> proxy = 8.0
+    // Blend: 0.4 * 10.0 + 0.6 * 8.0 = 4.0 + 4.8 = 8.8
+    const currStats: PpgSample[] = [
