diff --git a/src/lib/tournaments/__tests__/engine.test.ts b/src/lib/tournaments/__tests__/engine.test.ts
new file mode 100644
index 00000000..b4541242
--- /dev/null
+++ b/src/lib/tournaments/__tests__/engine.test.ts
@@ -0,0 +1,143 @@
+import { describe, expect, it } from 'vitest';
+import {
+  nextPow2,
+  roundName,
+  getSeeding,
+  seedBracket,
+  buildRoundSpecs,
+  resolveTiebreaker,
+  type SeedEntry,
+} from '../engine';
+
+describe('Tournament Engine', () => {
+  describe('nextPow2 & roundName', () => {
+    it('calculates the next power of 2 correctly', () => {
+      expect(nextPow2(1)).toBe(1);
+      expect(nextPow2(2)).toBe(2);
+      expect(nextPow2(3)).toBe(4);
+      expect(nextPow2(7)).toBe(8);
+      expect(nextPow2(10)).toBe(16);
+    });
+
+    it('assigns correct round names', () => {
+      // 8 slots, 3 total rounds
+      expect(roundName(8, 0, 3)).toBe('Quarter-Final');
+      expect(roundName(8, 1, 3)).toBe('Semi-Final');
+      expect(roundName(8, 2, 3)).toBe('Final');
+
+      // 16 slots, 4 total rounds
+      expect(roundName(16, 0, 4)).toBe('Round of 16');
+      expect(roundName(16, 1, 4)).toBe('Quarter-Final');
+      expect(roundName(16, 2, 4)).toBe('Semi-Final');
+      expect(roundName(16, 3, 4)).toBe('Final');
+    });
+  });
+
+  describe('seeding & bracket generation', () => {
+    it('produces standard 4-team and 8-team seed orders', () => {
+      expect(getSeeding(4)).toEqual([1, 4, 2, 3]);
+      expect(getSeeding(8)).toEqual([1, 8, 4, 5, 2, 7, 3, 6]);
+    });
+
+    it('places teams into bracket slots with byes for missing seeds', () => {
+      const teams: SeedEntry[] = [
+        { teamId: 'team-1', seed: 1 },
+        { teamId: 'team-2', seed: 2 },
+        { teamId: 'team-3', seed: 3 },
+      ];
+      // Bracket size 4: seeds [1, 4, 2, 3]
+      // seed 1 -> slot 0 ('team-1')
+      // seed 4 -> slot 1 (null - bye for seed 1)
+      // seed 2 -> slot 2 ('team-2')
+      // seed 3 -> slot 3 ('team-3')
+      const slots = seedBracket(teams, 4);
+      expect(slots).toEqual(['team-1', null, 'team-2', 'team-3']);
+    });
+  });
+
+  describe('buildRoundSpecs', () => {
+    it('builds specs for secondary_cup (League Cup)', () => {
+      const specs = buildRoundSpecs(8, 'secondary_cup', 10);
+      expect(specs.length).toBe(3);
+      // QF, SF, Final
+      expect(specs[0].name).toBe('Quarter-Final');
+      expect(specs[0].startGameweek).toBe(16);
+      expect(specs[0].isTwoLeg).toBe(false);
+
+      expect(specs[1].name).toBe('Semi-Final');
+      expect(specs[1].startGameweek).toBe(21);
+      expect(specs[1].endGameweek).toBe(24);
+      expect(specs[1].isTwoLeg).toBe(true);
+
+      expect(specs[2].name).toBe('Final');
+      expect(specs[2].startGameweek).toBe(31);
+      expect(specs[2].endGameweek).toBe(31);
+      expect(specs[2].isTwoLeg).toBe(false);
+    });
+
+    it('builds specs for primary_cup (Champions Cup)', () => {
+      const specs = buildRoundSpecs(8, 'primary_cup', 10);
+      expect(specs.length).toBe(3);
+      // QF (two-leg), SF (two-leg), Final (one-leg)
+      expect(specs[0].name).toBe('Quarter-Final');
+      expect(specs[0].isTwoLeg).toBe(true);
+      expect(specs[0].startGameweek).toBe(32);
+      expect(specs[0].endGameweek).toBe(33);
+
+      expect(specs[1].name).toBe('Semi-Final');
+      expect(specs[1].isTwoLeg).toBe(true);
+      expect(specs[1].startGameweek).toBe(34);
+      expect(specs[1].endGameweek).toBe(35);
+
+      expect(specs[2].name).toBe('Final');
+      expect(specs[2].isTwoLeg).toBe(false);
+      expect(specs[2].startGameweek).toBe(38);
+      expect(specs[2].endGameweek).toBe(38);
+    });
+  });
+
+  describe('resolveTiebreaker', () => {
+    it('awards the win to the team with the highest individual scorer', () => {
+      const teamA = [
+        { playerId: 'p1', points: 12 },
+        { playerId: 'p2', points: 8 },
+      ];
+      const teamB = [
+        { playerId: 'p3', points: 15 }, // highest
+        { playerId: 'p4', points: 5 },
+      ];
+
+      expect(resolveTiebreaker(teamA, teamB, 'team-a', 'team-b')).toBe('team-b');
+    });
+
+    it('returns team A if team A has the highest individual scorer', () => {
+      const teamA = [
+        { playerId: 'p1', points: 22 }, // highest
+        { playerId: 'p2', points: 4 },
+      ];
+      const teamB = [
+        { playerId: 'p3', points: 18 },
+        { playerId: 'p4', points: 8 },
+      ];
+
+      expect(resolveTiebreaker(teamA, teamB, 'team-a', 'team-b')).toBe('team-a');
+    });
+
+    it('returns null if both teams have the same top individual score', () => {
+      const teamA = [
+        { playerId: 'p1', points: 14 },
+        { playerId: 'p2', points: 10 },
+      ];
+      const teamB = [
+        { playerId: 'p3', points: 14 },
+        { playerId: 'p4', points: 10 },
+      ];
+
+      expect(resolveTiebreaker(teamA, teamB, 'team-a', 'team-b')).toBeNull();
+    });
+
+    it('handles empty player arrays gracefully', () => {
+      expect(resolveTiebreaker([], [], 'team-a', 'team-b')).toBeNull();
+    });
+  });
+});
