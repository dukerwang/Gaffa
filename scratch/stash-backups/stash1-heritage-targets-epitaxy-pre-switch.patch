diff --git a/src/lib/positions/sideOrder.ts b/src/lib/positions/sideOrder.ts
new file mode 100644
index 00000000..82266053
--- /dev/null
+++ b/src/lib/positions/sideOrder.ts
@@ -0,0 +1,46 @@
+/**
+ * Orders players who share one exact formation slot (two CBs in a back four,
+ * three CBs in a back three, a double pivot, etc.) left-to-right by their
+ * `side_hint` — SoFIFA's own LCB/RCB/LDM/RDM/LCM/RCM/LAM/RAM/LS/RS tag,
+ * collapsed everywhere else in the app down to the coarse GranularPosition.
+ *
+ * Selection (which players make the XI) has already happened by the time
+ * this runs — it only rearranges players who were tied on the exact same
+ * slot, so a stable sort keeps the original (rating-based) order as the
+ * tiebreak whenever both sides are the same or unknown.
+ */
+const RANK: Record<'L' | 'R', number> = { L: 0, R: 2 };
+
+function sideRank(hint: 'L' | 'R' | null | undefined): number {
+  return hint ? RANK[hint] : 1;
+}
+
+/**
+ * Stably reorders `items` in place among only the index groups that share
+ * the same `keyOf` value, using `hintOf` to rank left/center/right. Indices
+ * belonging to different keys never move relative to each other.
+ */
+export function orderBySide<T>(
+  items: T[],
+  keyOf: (item: T) => string,
+  hintOf: (item: T) => 'L' | 'R' | null | undefined,
+): T[] {
+  const groups = new Map<string, number[]>();
+  items.forEach((item, i) => {
+    const key = keyOf(item);
+    if (!groups.has(key)) groups.set(key, []);
+    groups.get(key)!.push(i);
+  });
+
+  const result = [...items];
+  for (const indices of groups.values()) {
+    if (indices.length < 2) continue;
+    const sorted = indices
+      .map((i) => items[i])
+      .map((item, i) => ({ item, i })) // stable: pair with original position within the group
+      .sort((a, b) => sideRank(hintOf(a.item)) - sideRank(hintOf(b.item)) || a.i - b.i)
+      .map(({ item }) => item);
+    indices.forEach((idx, k) => { result[idx] = sorted[k]; });
+  }
+  return result;
+}
